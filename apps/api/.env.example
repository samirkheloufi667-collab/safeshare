# Base PostgreSQL locale (npm run db:local) — ou celle de docker-compose.
# pgbouncer=true : PGlite partage une seule session entre toutes les connexions ;
# ce réglage empêche Prisma de nommer ses requêtes préparées (conflits entre clients).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5435/postgres?connection_limit=1&sslmode=disable&pgbouncer=true"
# Secret de signature des jetons : une longue chaîne aléatoire en production.
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"
# Adresse de l'interface (CORS, cookies, liens de partage).
WEB_ORIGIN="http://localhost:5174"
PORT=4200
# Dossier de stockage des fichiers (créé au besoin).
STORAGE_DIR="./storage"
